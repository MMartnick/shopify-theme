{%- comment -%}
  Robots, Open Graph / Twitter share tags and structured data
  (Organization, WebSite, BreadcrumbList, Product).
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  if request.page_type == 'product'
    assign og_type = 'product'
  endif

  # Keep filtered, sorted and search result pages out of the index; the
  # unfiltered collection is the page that should rank.
  assign noindex = false
  if request.page_type == 'search'
    assign noindex = true
  endif
  if request.page_type == 'collection'
    if collection.sort_by != blank
      assign noindex = true
    endif
    for filter in collection.filters
      if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil
        assign noindex = true
      endif
    endfor
  endif

  assign origin = request.origin
  assign home_url = origin | append: routes.root_url
-%}
{%- if noindex -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if page_image -%}
  {%- liquid
    assign og_w = page_image.width
    if og_w > 1200
      assign og_w = 1200
    endif
    assign og_h = og_w | divided_by: page_image.aspect_ratio | round
  -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ og_w }}">
  <meta property="og:image:height" content="{{ og_h }}">
  <meta property="og:image:alt" content="{{ page_image.alt | default: og_title | escape }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "OnlineStore",
  "@id": {{ home_url | append: '#store' | json }},
  "name": {{ shop.name | json }},
  "url": {{ home_url | json }},
  "logo": {{ 'apple-touch-icon.png' | asset_url | prepend: 'https:' | json }},
  "parentOrganization": {
    "@type": "Organization",
    "name": "Concept 1984",
    "url": "https://concept1984.com"
  }
  {%- if settings.social_instagram != blank -%},
  "sameAs": [{{ settings.social_instagram | json }}, "https://concept1984.com"]
  {%- endif %}
}
</script>

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ home_url | json }},
    "publisher": { "@id": {{ home_url | append: '#store' | json }} },
    "potentialAction": {
      "@type": "SearchAction",
      "target": {{ origin | append: routes.search_url | append: '?q={search_term_string}' | json }},
      "query-input": "required name=search_term_string"
    }
  }
  </script>
{%- endif -%}

{%- if request.page_type == 'collection' or request.page_type == 'product' -%}
  {%- liquid
    if request.page_type == 'product' and product.vendor != blank
      assign artist_handle = product.vendor | handleize
      assign artist_collection = collections[artist_handle]
    endif
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Store", "item": {{ origin | append: routes.all_products_collection_url | json }} },
      {%- if request.page_type == 'collection' -%}
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ origin | append: collection.url | json }} }
      {%- elsif artist_collection != blank -%}
        { "@type": "ListItem", "position": 2, "name": {{ artist_collection.title | json }}, "item": {{ origin | append: artist_collection.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ origin | append: product.url | json }} }
      {%- else -%}
        { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ origin | append: product.url | json }} }
      {%- endif -%}
    ]
  }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- liquid
    assign v = product.selected_or_first_available_variant
    # Put a space at tag boundaries so paragraphs don't run together, then
    # collapse whitespace (split on ' ' splits on any run of whitespace).
    assign ld_description = product.description | replace: '<', ' <' | strip_html | split: ' ' | join: ' ' | truncate: 5000
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ origin | append: product.url | json }},
    {%- if product.images.size > 0 -%}
    "image": [
      {%- for image in product.images limit: 6 -%}
        {{ image | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    {%- endif -%}
    {%- if ld_description != blank -%}"description": {{ ld_description | json }},{%- endif -%}
    {%- if product.type != blank -%}"category": {{ product.type | json }},{%- endif -%}
    {%- if product.vendor != blank -%}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "creator": { "@type": "Person", "name": {{ product.vendor | json }} },
    {%- endif -%}
    {%- if v.sku != blank -%}"sku": {{ v.sku | json }},{%- endif -%}
    "offers": [
      {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
        "name": {{ variant.title | json }},
        "itemCondition": "https://schema.org/NewCondition",
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "url": {{ origin | append: variant.url | json }},
        "seller": { "@id": {{ home_url | append: '#store' | json }} }
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}
