{%- assign current_variant = product.selected_or_first_available_variant -%}
<div class="product-page">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.all_products_collection_url }}">Store</a>
    <span aria-hidden="true">/</span>
    {%- render 'artist-link', vendor: product.vendor, class: 'breadcrumb-artist' -%}
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ product.title }}</span>
  </nav>

  <div class="product-layout">
    <div class="product-images">
      <div class="product-main-image">
        {%- assign main_image = current_variant.featured_image | default: product.featured_image -%}
        {%- if main_image -%}
          <img
            src="{{ main_image | image_url: width: 1400 }}"
            srcset="{{ main_image | image_url: width: 700 }} 700w, {{ main_image | image_url: width: 1000 }} 1000w, {{ main_image | image_url: width: 1400 }} 1400w"
            sizes="(max-width: 900px) 100vw, 55vw"
            alt="{{ main_image.alt | default: product.title | escape }}"
            width="1400" height="{{ 1400 | divided_by: main_image.aspect_ratio | round }}"
            id="product-main-img"
          >
        {%- else -%}
          <div class="product-card-placeholder">{% render 'icon', name: 'image' %}</div>
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="product-thumbnails">
          {%- for image in product.images -%}
            <button
              type="button"
              class="product-thumbnail{% if image.id == main_image.id %} active{% endif %}"
              data-image-id="{{ image.id }}"
              data-image-src="{{ image | image_url: width: 1400 }}"
              data-image-srcset="{{ image | image_url: width: 700 }} 700w, {{ image | image_url: width: 1000 }} 1000w, {{ image | image_url: width: 1400 }} 1400w"
              data-image-alt="{{ image.alt | default: product.title | escape }}"
              aria-label="View image {{ forloop.index }}"
            >
              <img src="{{ image | image_url: width: 160 }}" alt="" loading="lazy" width="80" height="{{ 80 | divided_by: image.aspect_ratio | round }}">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-info">
      <p class="product-meta">
        {%- render 'artist-link', vendor: product.vendor, class: 'product-artist' -%}
        {%- if product.type != blank -%}
          <a href="{{ product.type | url_for_type }}" class="product-type">{{ product.type }}</a>
        {%- endif -%}
      </p>
      <h1 class="product-title">{{ product.title }}</h1>

      <div class="product-price" data-product-price>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="price-compare">{{ current_variant.compare_at_price | money }}</span>
        {%- endif -%}
        <span class="price-current{% if current_variant.compare_at_price > current_variant.price %} on-sale{% endif %}">{{ current_variant.price | money }}</span>
      </div>

      {%- form 'product', product, id: 'product-form', class: 'product-form', data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="product-option">
              <label for="option-{{ forloop.index }}">{{ option.name }}</label>
              <select id="option-{{ forloop.index }}" data-option-index="{{ forloop.index0 }}">
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="product-quantity">
          <label for="quantity">Quantity</label>
          <div class="quantity-selector">
            <button type="button" class="qty-btn" data-qty-step="-1" aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" id="quantity" value="1" min="1">
            <button type="button" class="qty-btn" data-qty-step="1" aria-label="Increase quantity">+</button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block add-to-cart" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
          {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
        </button>
        <p class="form-error" role="alert" data-form-error hidden></p>
      {%- endform -%}

      {%- if product.description != blank -%}
        <div class="product-description rte">
          {{ product.description }}
        </div>
      {%- endif -%}

      {%- if product.vendor != blank -%}
        <div class="product-artist-more">
          <p class="kicker">Artist</p>
          <p>More from {% render 'artist-link', vendor: product.vendor %}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script type="application/json" data-product-json>
  {
    "variants": [
      {%- for v in product.variants -%}
        {
          "id": {{ v.id }},
          "options": {{ v.options | json }},
          "available": {{ v.available | json }},
          "price": {{ v.price | money | json }},
          "compare_at_price": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
          "image_id": {% if v.featured_image %}{{ v.featured_image.id }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var form = document.querySelector('[data-product-form]');
  if (!form) return;
  var data = JSON.parse(document.querySelector('[data-product-json]').textContent);
  var idInput = form.querySelector('[data-variant-id]');
  var selects = Array.from(form.querySelectorAll('[data-option-index]'));
  var button = form.querySelector('[data-add-to-cart]');
  var priceEl = document.querySelector('[data-product-price]');
  var errorEl = form.querySelector('[data-form-error]');
  var mainImg = document.getElementById('product-main-img');
  var thumbs = Array.from(document.querySelectorAll('.product-thumbnail'));

  function showImage(thumb) {
    if (!thumb || !mainImg) return;
    thumbs.forEach(function (t) { t.classList.toggle('active', t === thumb); });
    mainImg.src = thumb.dataset.imageSrc;
    mainImg.srcset = thumb.dataset.imageSrcset;
    mainImg.alt = thumb.dataset.imageAlt;
  }
  thumbs.forEach(function (t) { t.addEventListener('click', function () { showImage(t); }); });

  // Map the chosen options to a variant and update id, price, button, URL, image.
  function onOptionChange() {
    var chosen = selects.map(function (s) { return s.value; });
    var variant = selects.length === 0 ? data.variants[0] : data.variants.find(function (v) {
      return v.options.every(function (o, i) { return o === chosen[i]; });
    });
    if (!variant) {
      button.disabled = true;
      button.textContent = 'Unavailable';
      return;
    }
    idInput.value = variant.id;
    button.disabled = !variant.available;
    button.textContent = variant.available ? 'Add to cart' : 'Sold out';
    priceEl.innerHTML =
      (variant.compare_at_price ? '<span class="price-compare">' + variant.compare_at_price + '</span>' : '') +
      '<span class="price-current' + (variant.compare_at_price ? ' on-sale' : '') + '">' + variant.price + '</span>';
    if (selects.length === 0) return;
    if (variant.image_id) {
      showImage(thumbs.find(function (t) { return t.dataset.imageId == variant.image_id; }));
    }
    var url = new URL(window.location.href);
    url.searchParams.set('variant', variant.id);
    history.replaceState(null, '', url.toString());
  }
  selects.forEach(function (s) { s.addEventListener('change', onOptionChange); });

  var qty = form.querySelector('#quantity');
  form.querySelectorAll('[data-qty-step]').forEach(function (b) {
    b.addEventListener('click', function () {
      qty.value = Math.max(1, (parseInt(qty.value, 10) || 1) + parseInt(b.dataset.qtyStep, 10));
    });
  });

  // Add to cart without leaving the page, then open the drawer.
  form.addEventListener('submit', function (e) {
    if (!window.Cart || !window.fetch) return;
    e.preventDefault();
    errorEl.hidden = true;
    button.disabled = true;
    fetch({{ routes.cart_add_url | json }} + '.js', {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: new FormData(form)
    })
      .then(function (r) { return r.json().then(function (body) { return { ok: r.ok, body: body }; }); })
      .then(function (res) {
        if (!res.ok) throw new Error(res.body.description || res.body.message || 'Could not add to cart.');
        return window.Cart.refresh().then(window.Cart.open);
      })
      .catch(function (err) {
        errorEl.textContent = err.message;
        errorEl.hidden = false;
      })
      .finally(function () { onOptionChange(); });
  });
});
</script>

{% schema %}
{
  "name": "Product page",
  "settings": []
}
{% endschema %}
