{%- comment -%} Home page intro, in the style of the concept1984.com plate. {%- endcomment -%}
<section class="section store-intro">
  <div class="store-intro-plate">
    <img src="{{ 'concept1984-lockup.svg' | asset_url }}" alt="Concept 1984" class="store-intro-lockup" width="220" height="193">
  </div>
  <div class="store-intro-text">
    {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    <h1 class="store-intro-title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<div class="store-intro-body">{{ section.settings.text }}</div>{%- endif -%}
    <div class="store-intro-actions">
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">Shop all</a>
      <a href="#artists" class="btn btn-secondary">Artists</a>
    </div>
  </div>
  <div class="cmyk-strip" aria-hidden="true"></div>
</section>

{% schema %}
{
  "name": "Store intro",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Label", "default": "Concept 1984 Store" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Prints and products from the artists we represent." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Concept 1984 is a graphic and interactive design studio. The store carries work by the artists who are part of the studio and the products we produce with them.</p>"
    }
  ],
  "presets": [{ "name": "Store intro" }]
}
{% endschema %}
