<div class="section store-intro password-page">
  <div class="store-intro-plate">
    <img src="{{ 'concept1984-lockup.svg' | asset_url }}" alt="Concept 1984" class="store-intro-lockup" width="220" height="193">
  </div>
  <div class="store-intro-text">
    <p class="kicker">Concept 1984 Store</p>
    <h1 class="store-intro-title">Opening soon.</h1>
    {%- if shop.password_message != blank -%}
      <div class="store-intro-body">{{ shop.password_message }}</div>
    {%- endif -%}

    {%- form 'storefront_password', class: 'search-form' -%}
      <label for="password" class="visually-hidden">Store password</label>
      <input type="password" name="password" id="password" placeholder="Store password" autocomplete="current-password">
      <button type="submit" class="btn btn-primary">Enter</button>
      {%- if form.errors -%}<p class="form-error" role="alert">Incorrect password.</p>{%- endif -%}
    {%- endform -%}

    <p class="store-intro-body">
      In the meantime: <a href="https://concept1984.com">concept1984.com</a>
      {%- if settings.social_instagram != blank %} · <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener noreferrer">@concept_1984</a>{%- endif -%}
    </p>
  </div>
  <div class="cmyk-strip" aria-hidden="true"></div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": []
}
{% endschema %}
