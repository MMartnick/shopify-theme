{%- comment -%}
  Artist directory. Add an "Artist" block per artist (pick their collection,
  optional portrait and bio). With no blocks, it lists every vendor in the
  store automatically, so new artists appear as soon as their products do.
{%- endcomment -%}
<section class="section artists" id="artists">
  <div class="section-head">
    <div>
      <p class="kicker">{{ section.settings.kicker }}</p>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="artist-grid">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign portrait = block.settings.image | default: c.image | default: c.products.first.featured_image -%}
        <a href="{{ c.url | default: '#' }}" class="artist-card" {{ block.shopify_attributes }}>
          <div class="artist-card-image">
            {%- if portrait -%}
              <img src="{{ portrait | image_url: width: 600 }}" alt="{{ portrait.alt | default: c.title | escape }}" loading="lazy" width="600" height="{{ 600 | divided_by: portrait.aspect_ratio | round }}">
            {%- else -%}
              {% render 'icon', name: 'image' %}
            {%- endif -%}
          </div>
          <div class="artist-card-info">
            <h3 class="artist-card-name">{{ c.title | default: 'Artist' }}</h3>
            {%- if block.settings.role != blank -%}<p class="artist-card-role">{{ block.settings.role }}</p>{%- endif -%}
            {%- if block.settings.bio != blank -%}<div class="artist-card-bio">{{ block.settings.bio }}</div>{%- endif -%}
            {%- if c -%}<p class="artist-card-count">{{ c.products_count }} {{ c.products_count | pluralize: 'work', 'works' }}</p>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  {%- elsif shop.vendors.size > 0 -%}
    <ul class="artist-list">
      {%- for vendor in shop.vendors -%}
        <li>{% render 'artist-link', vendor: vendor, class: 'artist-list-link' %}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Artists",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Label", "default": "Represented" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Artists" }
  ],
  "blocks": [
    {
      "type": "artist",
      "name": "Artist",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Artist collection", "info": "Name the collection exactly like the artist's Vendor so product pages link to it." },
        { "type": "image_picker", "id": "image", "label": "Portrait or key work", "info": "Defaults to the collection image." },
        { "type": "text", "id": "role", "label": "Discipline", "placeholder": "Illustration, lettering" },
        { "type": "richtext", "id": "bio", "label": "Short bio" }
      ]
    }
  ],
  "presets": [{ "name": "Artists" }]
}
{% endschema %}
