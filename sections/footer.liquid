<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-content">
      <div class="footer-section footer-brand">
        <img src="{{ 'concept1984-lockup.svg' | asset_url }}" alt="Concept 1984" width="120" height="105" loading="lazy">
        <p>{{ section.settings.tagline }}</p>
      </div>

      <div class="footer-section">
        <h2 class="footer-heading">Store</h2>
        <nav class="footer-nav" aria-label="Store">
          <a href="{{ routes.all_products_collection_url }}">All products</a>
          <a href="{{ routes.root_url }}#artists">Artists</a>
          <a href="/policies/shipping-policy">Shipping</a>
          <a href="/policies/refund-policy">Returns</a>
        </nav>
      </div>

      <div class="footer-section">
        <h2 class="footer-heading">Studio</h2>
        <nav class="footer-nav" aria-label="Studio">
          <a href="https://concept1984.com">concept1984.com</a>
          <a href="https://concept1984.com/work">Selected work</a>
          <a href="https://concept1984.com/about">About / contact</a>
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener noreferrer" class="footer-social">
              {% render 'icon', name: 'instagram' %} <span>@concept_1984</span>
            </a>
          {%- endif -%}
        </nav>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">&copy; {{ 'now' | date: '%Y' }} Concept 1984. Works &copy; their respective artists.</p>
      <div class="payment-icons">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'payment-icon' }}
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Prints and products from the artists Concept 1984 represents and produces."
    }
  ]
}
{% endschema %}
