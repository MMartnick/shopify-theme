<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-content">
      <div class="footer-section">
        <h4>{{ shop.name }}</h4>
        <p>Original artwork and prints by Matt Martnick</p>
      </div>

      <div class="footer-section">
        <h4>Links</h4>
        <nav class="footer-nav">
          <a href="https://matthewmartnick.com/">Portfolio</a>
          <a href="https://matthewmartnick.com/about">About</a>
          <a href="https://ko-fi.com/doom_monsta/commissions">Commissions</a>
          <a href="/policies/shipping-policy">Shipping</a>
          <a href="/policies/refund-policy">Returns</a>
        </nav>
      </div>

      <div class="footer-section">
        <h4>Connect</h4>
        <div class="footer-social">
          <a href="https://instagram.com/doom_monsta" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <i class="fab fa-instagram"></i>
          </a>
          <a href="https://www.saatchiart.com/account/profile/2849633" target="_blank" rel="noopener noreferrer" aria-label="Saatchi Art">
            <i class="fa fa-palette"></i>
          </a>
          <a href="https://www.artstation.com/doom_monsta" target="_blank" rel="noopener noreferrer" aria-label="ArtStation">
            <i class="fab fa-artstation"></i>
          </a>
          <a href="https://www.behance.net/mattMartnick" target="_blank" rel="noopener noreferrer" aria-label="Behance">
            <i class="fab fa-behance"></i>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      <div class="payment-icons">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'payment-icon' }}
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
