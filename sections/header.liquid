{%- comment -%}
  Store header: Concept 1984 mark + "Store" tag, store links, links back to
  concept1984.com, studio Instagram, cart. The navigation is fixed in the
  theme (not read from a Shopify admin menu) so it only ever points to the
  store and the studio site.
{%- endcomment -%}
{%- capture nav_links -%}
  <a href="{{ routes.all_products_collection_url }}" class="nav-link{% if request.page_type == 'collection' %} active{% endif %}">Shop</a>
  <a href="{{ routes.root_url }}#artists" class="nav-link">Artists</a>
  <a href="https://concept1984.com/work" class="nav-link">Work</a>
  <a href="https://concept1984.com/about" class="nav-link">About</a>
  <a href="https://concept1984.com" class="nav-link">Studio</a>
{%- endcapture -%}

<header class="site-header">
  <div class="header-inner">
    <a href="{{ routes.root_url }}" class="site-title" aria-label="{{ shop.name }} home">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" class="site-logo" width="120" height="40">
      {%- else -%}
        <img src="{{ 'concept1984-mark.svg' | asset_url }}" alt="" class="site-mark" width="55" height="40">
        <span class="site-name">Concept 1984</span>
        <span class="site-tag">Store</span>
      {%- endif -%}
    </a>

    <nav class="site-nav desktop-nav" aria-label="Main">
      {{ nav_links }}
    </nav>

    <div class="header-right">
      {%- if settings.social_instagram != blank -%}
        <a href="{{ settings.social_instagram }}" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Concept 1984 on Instagram">
          {% render 'icon', name: 'instagram' %}
        </a>
      {%- endif -%}

      <button type="button" class="cart-toggle" aria-label="Open cart" data-cart-toggle>
        {% render 'icon', name: 'bag' %}
        <span class="cart-count{% if cart.item_count == 0 %} hidden{% endif %}" data-cart-count>{{ cart.item_count }}</span>
      </button>

      <button type="button" class="mobile-menu-toggle" aria-label="Open menu" aria-expanded="false" data-menu-toggle>
        {% render 'icon', name: 'menu' %}
      </button>
    </div>
  </div>

  <div class="mobile-nav-drawer" data-menu-drawer aria-label="Menu">
    <div class="mobile-nav-header">
      <span>Menu</span>
      <button type="button" class="mobile-nav-close" aria-label="Close menu" data-menu-close>
        {% render 'icon', name: 'close' %}
      </button>
    </div>
    <nav class="mobile-nav" aria-label="Mobile">
      {{ nav_links }}
    </nav>
    {%- if settings.social_instagram != blank -%}
      <div class="mobile-nav-social">
        <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Concept 1984 on Instagram">
          {% render 'icon', name: 'instagram' %} <span>@concept_1984</span>
        </a>
      </div>
    {%- endif -%}
  </div>
  <div class="drawer-overlay" data-drawer-overlay></div>
</header>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var toggle = document.querySelector('[data-menu-toggle]');
  var drawer = document.querySelector('[data-menu-drawer]');
  var close = document.querySelector('[data-menu-close]');
  var overlay = document.querySelector('[data-drawer-overlay]');
  function setOpen(open) {
    drawer.classList.toggle('open', open);
    overlay.classList.toggle('open', open);
    if (toggle) toggle.setAttribute('aria-expanded', open);
    document.body.style.overflow = open ? 'hidden' : '';
  }
  if (toggle) toggle.addEventListener('click', function () { setOpen(true); });
  if (close) close.addEventListener('click', function () { setOpen(false); });
  if (overlay) overlay.addEventListener('click', function () { setOpen(false); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
});
</script>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
