<div class="error-page">
  <p class="kicker">Error 404</p>
  <h1 class="page-title">Page not found</h1>
  <p>The page you were looking for doesn't exist or has moved.</p>
  <div class="error-actions">
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">Browse the store</a>
    <a href="{{ routes.root_url }}" class="btn btn-secondary">Store home</a>
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "settings": []
}
{% endschema %}
