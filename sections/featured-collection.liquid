{%- liquid
  assign featured = section.settings.collection
  if featured == blank
    assign featured = collections.all
  endif
-%}
<section class="section featured-collection">
  <div class="section-head">
    <div>
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    {%- if section.settings.show_view_all -%}
      <a href="{{ featured.url }}" class="section-link">View all {% render 'icon', name: 'arrow-right' %}</a>
    {%- endif -%}
  </div>

  <div class="product-grid">
    {%- for product in featured.products limit: section.settings.products_to_show -%}
      {% render 'product-card', product: product %}
    {%- else -%}
      <p class="no-products">No products yet.</p>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Label", "default": "Store" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New work" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 16, "step": 1, "default": 8, "label": "Products to show" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show “View all” link", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
