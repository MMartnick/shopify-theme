<div class="cart-page">
  <p class="kicker">Store</p>
  <h1 class="page-title">Cart</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      <ul class="cart-items cart-items--page">
        {%- for item in cart.items -%}
          <li class="cart-item">
            <a href="{{ item.url }}" class="cart-item-image">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.title | escape }}" loading="lazy" width="120" height="{{ 120 | divided_by: item.image.aspect_ratio | round }}">
              {%- endif -%}
            </a>
            <div class="cart-item-details">
              {%- if item.vendor != blank -%}<p class="cart-item-artist">{% render 'artist-link', vendor: item.vendor %}</p>{%- endif -%}
              <a href="{{ item.url }}" class="cart-item-title">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="cart-item-variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              <p class="cart-item-unit">{{ item.final_price | money }}</p>
            </div>
            <div class="cart-item-quantity">
              <label for="qty-{{ forloop.index }}" class="visually-hidden">Quantity for {{ item.product.title | escape }}</label>
              <div class="quantity-selector">
                <button type="button" class="qty-btn" onclick="this.nextElementSibling.stepDown(); this.form.submit();" aria-label="Decrease quantity">−</button>
                <input type="number" name="updates[]" id="qty-{{ forloop.index }}" value="{{ item.quantity }}" min="0">
                <button type="button" class="qty-btn" onclick="this.previousElementSibling.stepUp(); this.form.submit();" aria-label="Increase quantity">+</button>
              </div>
            </div>
            <div class="cart-item-total">{{ item.final_line_price | money }}</div>
            <a href="{{ item.url_to_remove }}" class="cart-item-remove" aria-label="Remove {{ item.product.title | escape }}">
              {% render 'icon', name: 'remove' %}
            </a>
          </li>
        {%- endfor -%}
      </ul>

      <div class="cart-footer">
        <div class="cart-subtotal">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-note">Shipping and taxes calculated at checkout.</p>
        <div class="cart-actions">
          <button type="submit" name="update" class="btn btn-secondary">Update cart</button>
          <button type="submit" name="checkout" class="btn btn-primary">Checkout</button>
        </div>
      </div>
    </form>
  {%- else -%}
    <div class="cart-empty">
      {% render 'icon', name: 'bag' %}
      <p>Your cart is empty.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">Browse the store</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart page",
  "settings": []
}
{% endschema %}
