<div class="page-content">
  <div class="page-inner">
    <h1 class="page-title">{{ page.title }}</h1>
    <div class="page-body">
      {{ page.content }}
    </div>
  </div>
</div>

<style>
.page-content {
  max-width: 800px;
  margin: 0 auto;
  padding: var(--spacing-lg) var(--spacing);
}
.page-body {
  line-height: 1.8;
}
.page-body h2, .page-body h3 {
  margin-top: 2rem;
  margin-bottom: 1rem;
}
.page-body p {
  margin-bottom: 1rem;
}
.page-body ul, .page-body ol {
  margin-bottom: 1rem;
  padding-left: 1.5rem;
}
</style>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
